{
  "note": "Shared test vectors, API note section 3a. raw is the JSON value the client sends (a string for keyboard fields and select, a boolean for boolean; absent = key not sent). expect.json is the exact JSON text the bot receives; expect.code is the 422 per-field code.",
  "fields": [
    {"id": "int-1", "spec": {"type": "integer", "min": 0, "max": 6, "required": false}, "raw": "3", "expect": {"json": "3"}},
    {"id": "int-2", "spec": {"type": "integer", "min": 0, "max": 6, "required": false}, "raw": "٣", "expect": {"json": "3"}, "why": "Arabic-Indic digit three (U+0663)"},
    {"id": "int-3", "spec": {"type": "integer", "min": 0, "max": 6, "required": false}, "raw": "۳", "expect": {"json": "3"}, "why": "Persian digit three (U+06F3)"},
    {"id": "int-4", "spec": {"type": "integer", "min": 0, "max": 6, "required": false}, "raw": "３", "expect": {"json": "3"}, "why": "fullwidth digit three (U+FF13)"},
    {"id": "int-5", "spec": {"type": "integer", "min": 0, "max": 6, "required": false}, "raw": "3.0", "expect": {"code": "not_integer"}},
    {"id": "int-6", "spec": {"type": "integer", "min": 0, "max": 6, "required": false}, "raw": "3,5", "expect": {"code": "not_integer"}},
    {"id": "int-7", "spec": {"type": "integer", "min": 0, "max": 6, "required": false}, "raw": "+3", "expect": {"code": "not_integer"}, "why": "no leading plus"},
    {"id": "int-8", "spec": {"type": "integer", "min": 0, "max": 6, "required": false}, "raw": "7", "expect": {"code": "too_large"}},
    {"id": "int-9", "spec": {"type": "integer", "min": 0, "max": 6, "required": false}, "raw": "-1", "expect": {"code": "too_small"}},
    {"id": "int-10", "spec": {"type": "integer", "min": -6, "max": 6, "required": false}, "raw": "−2", "expect": {"json": "-2"}, "why": "U+2212 minus sign"},
    {"id": "int-11", "spec": {"type": "integer", "min": 0, "max": 5000, "required": false}, "raw": "1 000", "expect": {"json": "1000"}, "why": "spaces are stripped"},
    {"id": "int-12", "spec": {"type": "integer", "min": 0, "max": 6, "required": false}, "raw": "", "expect": {"json": "null"}, "why": "unanswered optional"},
    {"id": "int-13", "spec": {"type": "integer", "min": 0, "max": 6}, "raw": "", "expect": {"code": "required"}},
    {"id": "int-14", "spec": {"type": "integer", "min": 0, "max": 9007199254740991}, "raw": "9007199254740992", "expect": {"code": "too_large"}, "why": "one past 2^53-1, compared as a digit string"},
    {"id": "int-15", "spec": {"type": "integer", "min": 0, "max": 6}, "raw": true, "expect": {"code": "invalid_type"}, "why": "boolean sent for an integer field"},
    {"id": "int-16", "spec": {"type": "integer", "min": 0, "max": 6}, "raw": 3, "expect": {"code": "invalid_type"}, "why": "keyboard fields arrive as strings, never JSON numbers"},

    {"id": "dec-1", "spec": {"type": "decimal", "scale": 2, "min": "0.01", "max": "10000"}, "raw": "12.50", "expect": {"json": "12.50"}, "why": "trailing zero kept"},
    {"id": "dec-2", "spec": {"type": "decimal", "scale": 2, "min": "0.01", "max": "10000"}, "raw": "12,5", "expect": {"json": "12.5"}, "why": "comma is the decimal separator"},
    {"id": "dec-3", "spec": {"type": "decimal", "scale": 2, "min": "0.01", "max": "10000"}, "raw": "١٢٫٥٠", "expect": {"json": "12.50"}, "why": "Arabic-Indic digits with U+066B"},
    {"id": "dec-4", "spec": {"type": "decimal", "scale": 2, "min": "0.01", "max": "10000"}, "raw": "1,234", "expect": {"code": "too_precise"}, "why": "no grouping: one separator, three decimals"},
    {"id": "dec-5", "spec": {"type": "decimal", "scale": 2, "min": "0.01", "max": "10000"}, "raw": "2.100", "expect": {"code": "too_precise"}, "why": "digits past scale are refused even when zero"},
    {"id": "dec-6", "spec": {"type": "decimal", "scale": 2, "min": "0.01", "max": "10000"}, "raw": "1.234,5", "expect": {"code": "not_number"}, "why": "two separators"},
    {"id": "dec-7", "spec": {"type": "decimal", "scale": 2, "min": "0.01", "max": "10000"}, "raw": "0", "expect": {"code": "too_small"}},
    {"id": "dec-8", "spec": {"type": "decimal", "scale": 2, "min": "0.01", "max": "10000"}, "raw": "10000.01", "expect": {"code": "too_large"}},
    {"id": "dec-9", "spec": {"type": "decimal", "scale": 2, "min": "0.01", "max": "10000"}, "raw": ".5", "expect": {"json": "0.5"}},
    {"id": "dec-10", "spec": {"type": "decimal", "scale": 2, "min": "0.01", "max": "10000"}, "raw": "12.", "expect": {"code": "not_number"}},
    {"id": "dec-11", "spec": {"type": "decimal", "scale": 2, "min": "0.01", "max": "10000"}, "raw": "1e3", "expect": {"code": "not_number"}},
    {"id": "dec-12", "spec": {"type": "decimal", "scale": 2, "min": "0.01", "max": "10000"}, "raw": "1 234.5", "expect": {"json": "1234.5"}, "why": "spaces are stripped"},
    {"id": "dec-13", "spec": {"type": "decimal", "scale": 2, "min": "-10", "max": "10"}, "raw": "−3.5", "expect": {"json": "-3.5"}, "why": "U+2212 minus sign"},
    {"id": "dec-14", "spec": {"type": "decimal", "scale": 2, "min": "-1", "max": "1"}, "raw": "-0.00", "expect": {"json": "0.00"}, "why": "zero never carries a sign"},
    {"id": "dec-15", "spec": {"type": "decimal", "scale": 2, "min": "0"}, "raw": "1000000000000.01", "expect": {"code": "too_large"}, "why": "absolute bound is 1e12"},

    {"id": "email-1", "spec": {"type": "email"}, "raw": " Ana@Example.COM ", "expect": {"json": "\"Ana@example.com\""}, "why": "trim; domain lowercased, local part untouched"},
    {"id": "email-2", "spec": {"type": "email"}, "raw": "ana@ÉCOLE.fr", "expect": {"json": "\"ana@école.fr\""}, "why": "Unicode domain lowercased"},
    {"id": "email-3", "spec": {"type": "email"}, "raw": "ana@@example.com", "expect": {"code": "invalid_email"}},
    {"id": "email-4", "spec": {"type": "email"}, "raw": "ana@example", "expect": {"code": "invalid_email"}, "why": "no dot in the domain"},
    {"id": "email-5", "spec": {"type": "email"}, "raw": "ana @example.com", "expect": {"code": "invalid_email"}, "why": "whitespace inside"},

    {"id": "url-1", "spec": {"type": "url", "required": false}, "raw": "example.com", "expect": {"json": "\"https://example.com\""}, "why": "https:// added when there is no scheme"},
    {"id": "url-2", "spec": {"type": "url", "required": false}, "raw": "HTTP://Example.com/Menu", "expect": {"json": "\"http://example.com/Menu\""}, "why": "scheme and host lowercased, path untouched"},
    {"id": "url-3", "spec": {"type": "url", "required": false}, "raw": "example.com:8080/a", "expect": {"json": "\"https://example.com:8080/a\""}, "why": "a port is not a scheme"},
    {"id": "url-4", "spec": {"type": "url", "required": false}, "raw": "https://bank.com@evil.example", "expect": {"code": "invalid_url"}, "why": "userinfo"},
    {"id": "url-5", "spec": {"type": "url", "required": false}, "raw": "ftp://example.com", "expect": {"code": "invalid_url"}, "why": "only http and https"},
    {"id": "url-6", "spec": {"type": "url", "required": false}, "raw": "javascript:alert(1)", "expect": {"code": "invalid_url"}},
    {"id": "url-7", "spec": {"type": "url", "required": false}, "raw": "localhost", "expect": {"code": "invalid_url"}, "why": "host needs a dot"},
    {"id": "url-8", "spec": {"type": "url", "required": false}, "raw": "", "expect": {"json": "null"}},

    {"id": "phone-1", "spec": {"type": "phone"}, "raw": "0912 345 678", "expect": {"json": "\"0912345678\""}, "why": "leading zero kept; a string, never a number"},
    {"id": "phone-2", "spec": {"type": "phone"}, "raw": "+351 912-345-678", "expect": {"json": "\"+351912345678\""}},
    {"id": "phone-3", "spec": {"type": "phone"}, "raw": "+٣٥١ ٩١٢ ٣٤٥ ٦٧٨", "expect": {"json": "\"+351912345678\""}, "why": "Arabic-Indic digits"},
    {"id": "phone-4", "spec": {"type": "phone"}, "raw": "(021) 555.0199", "expect": {"json": "\"0215550199\""}, "why": "parentheses, spaces, dots and hyphens are stripped"},
    {"id": "phone-5", "spec": {"type": "phone"}, "raw": "12345", "expect": {"code": "invalid_phone"}, "why": "fewer than 7 digits"},
    {"id": "phone-6", "spec": {"type": "phone"}, "raw": "0912-ABC-678", "expect": {"code": "invalid_phone"}},

    {"id": "str-1", "spec": {"type": "string", "min_length": 2, "max_length": 60}, "raw": "  Lisbon ", "expect": {"json": "\"Lisbon\""}},
    {"id": "str-2", "spec": {"type": "string", "min_length": 2, "max_length": 60}, "raw": "L", "expect": {"code": "too_short"}},
    {"id": "str-3", "spec": {"type": "string", "min_length": 1, "max_length": 60}, "raw": "é", "expect": {"json": "\"é\""}, "why": "NFC: e + combining acute becomes one code point"},
    {"id": "str-4", "spec": {"type": "string", "min_length": 2, "max_length": 60}, "raw": "", "expect": {"code": "required"}},
    {"id": "str-5", "spec": {"type": "string", "max_length": 5}, "raw": "abcdef", "expect": {"code": "too_long"}},
    {"id": "para-1", "spec": {"type": "paragraph", "required": false}, "raw": "a\r\nb\n\n", "expect": {"json": "\"a\\nb\""}, "why": "CRLF becomes LF; trailing newlines trimmed; inner newlines kept"},

    {"id": "sel-1", "spec": {"type": "select", "options": [{"value": "s", "label": "S"}, {"value": "m", "label": "M"}, {"value": "l", "label": "L"}, {"value": "xl", "label": "XL"}], "required": false}, "raw": "m", "expect": {"json": "\"m\""}},
    {"id": "sel-2", "spec": {"type": "select", "options": [{"value": "s", "label": "S"}, {"value": "m", "label": "M"}, {"value": "l", "label": "L"}, {"value": "xl", "label": "XL"}], "required": false}, "raw": "xxl", "expect": {"code": "invalid_choice"}},
    {"id": "sel-3", "spec": {"type": "select", "options": [{"value": "s", "label": "S"}, {"value": "m", "label": "M"}], "required": false}, "raw": "", "expect": {"json": "null"}},
    {"id": "sel-4", "spec": {"type": "select", "options": [{"value": "s", "label": "S"}, {"value": "m", "label": "M"}]}, "raw": "", "expect": {"code": "required"}},

    {"id": "bool-1", "spec": {"type": "boolean"}, "raw": true, "expect": {"json": "true"}},
    {"id": "bool-2", "spec": {"type": "boolean"}, "raw": "true", "expect": {"code": "invalid_type"}, "why": "a string is not a boolean"},
    {"id": "bool-3", "spec": {"type": "boolean"}, "expect": {"json": "false"}, "why": "key absent: false, never null"}
  ],
  "forms": [
    {"id": "form-1", "fields": [{"id": "a", "type": "string"}, {"id": "b", "type": "integer", "required": false}], "values": {"a": "x", "c": "y"}, "expect": {"errors": {"c": "unknown_field"}, "values": {"a": "\"x\"", "b": "null"}}, "why": "unknown key; every declared field still present"},
    {"id": "form-2", "fields": [{"id": "a", "type": "string"}, {"id": "b", "type": "integer", "required": false}], "values": {}, "expect": {"errors": {"a": "required"}, "values": {"b": "null"}}, "why": "missing required key"}
  ]
}
